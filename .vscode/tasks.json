{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Active Example",
            "type": "shell",
            "command": "cargo build --release --example ${fileBasenameNoExtension}",
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the currently active example file"
        },
        {
            "label": "Flash Active Example",
            "type": "shell",
            "command": "espflash flash --monitor target/riscv32imc-unknown-none-elf/release/examples/${fileBasenameNoExtension}",
            "problemMatcher": [],
            "detail": "Flash the currently active example file"
        },
        {
            "label": "Build Example",
            "type": "shell",
            "command": "cargo build --release --example ${input:exampleName}",
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
            "detail": "Build a specific example"
        },
        {
            "label": "Flash Example",
            "type": "shell",
            "command": "espflash flash --monitor target/riscv32imc-unknown-none-elf/release/examples/${input:exampleName}",
            "problemMatcher": [],
            "detail": "Flash a specific example"
        },
        {
