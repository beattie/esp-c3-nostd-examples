{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Example (Test Build)",
            "type": "shell",
            "command": "cargo build --release --example ${input:exampleName} ${input:features}",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build + Flash + Monitor",
            "type": "shell",
            "command": "cargo build --release --example ${input:exampleName} ${input:features} && espflash flash --monitor target/riscv32imc-unknown-none-elf/release/examples/${input:exampleName}",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "exampleName",
            "type": "pickString",
            "description": "Select example to build",
            "options": [
                "blinky",
                "ws2812b_rainbow",
                "oled_display",
                "oled_display_more",
                "ble_scanner",
                "ble_bas_peripheral",
                "ble_clock",
                "ble_gatt_simple",
                "embassy_hello_world"
            ],
            "default": "blinky"
        },
        {
            "id": "features",
            "type": "pickString",
            "description": "Features (if needed)",
            "options": [
                "",
                "--features ble",
                "--features embassy"
            ],
            "default": ""
        }
    ]
}
