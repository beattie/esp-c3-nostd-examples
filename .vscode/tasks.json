{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Example",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--example",
                "${input:exampleName}",
                "${input:features}"
            ],
            "problemMatcher": ["$rustc"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build + Flash + Monitor",
            "type": "shell",
            "command": "cargo build --release --example ${input:exampleName} ${input:features} && espflash flash --monitor target/riscv32imc-unknown-none-elf/release/examples/${input:exampleName}",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "exampleName",
            "type": "promptString",
            "description": "Example name (blinky, ws2812b_rainbow, oled_display, ble_scanner, embassy_hello_world)",
            "default": "blinky"
        },
        {
            "id": "features",
            "type": "pickString",
            "description": "Features (if needed)",
            "options": [
                "",
                "--features ble",
                "--features embassy"
            ],
            "default": ""
        }
    ]
}
